# Copy to .env (gitignored) before `docker compose up -d`.
#
# Comma-separated token:role pairs. Roles: worker, client, admin.
#   worker — registers devices, reports job status and logs
#   client — submits jobs, reads state and logs
#   admin  — the above, plus clearing an unhealthy device
#
# Generate each value with: openssl rand -hex 24
# Tokens are bearer credentials with no transport security of their own —
# reach the controller over a tunnel or a private network, not the open
# internet. A duplicate or empty token is rejected at startup.

RC_TOKENS=replace-worker-token:worker,replace-client-token:client,replace-admin-token:admin
